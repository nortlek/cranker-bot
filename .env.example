# Use a dedicated, reliable Ethereum mainnet RPC in production.
RPC_URL=https://ethereum-rpc.publicnode.com
# Read-only bulk discovery scans use a separate endpoint so they cannot delay
# the latency-sensitive keeper loop.
DISCOVERY_RPC_URLS=https://eth-mainnet.public.blastapi.io,https://mainnet.gateway.tenderly.co,https://rpc.mevblocker.io
DISCOVERY_CONCURRENCY=2
DISCOVERY_VAULT_CHUNK_SIZE=250

# Transaction 0xe446... called this factory. The pool is checked at startup.
FACTORY_ADDRESS=0xe60a9341C3C73636B911e609dEFaf05B09EDeB9C
VAULT_FACTORY_ADDRESS=0x83d06Fe376c87765548B680800a935B79253412E
EXPECTED_POOL_ADDRESS=0xB2D80254af189854Bf90D2C338d87236d67D2bF3
EXPECTED_FWA_TOKEN_ADDRESS=0xa0Df17B5aC76ABaBA36E1450E2cbCd18A620C845

# Permissionless FWA work beyond standing orders.
ENABLE_POOL_LIFECYCLE=true
ENABLE_VAULTS=true
ENABLE_BUYBACK=true
# A separate permissionless 0.5%-reward lane. The adapter is read and
# simulated every block, but called only when the exact reward clears costs.
ENABLE_LIVE_BID_SWEEP=true
LIVE_BID_ADAPTER_ADDRESS=0x8C72FBc2bB32e76aa54243F76745266a0F92CD01
# Liquity V2 liquidations pay a fixed 0.0375 WETH gas compensation per trove,
# plus collateral compensation. Only the fixed WETH amount is budgeted.
ENABLE_LIQUITY_LIQUIDATIONS=true
# Convex pays 0.5% of newly claimed CRV to the earmark caller.
ENABLE_CONVEX_EARMARKS=true
# Expired vlCVX locks pay the permissionless kicker a CVX reward.
ENABLE_CONVEX_KICKS=true
# Stake DAO v4's Curve Accountant pays a CRV harvest fee. This lane is
# private-only and defaults off until a dry-run validates the production RPC.
ENABLE_STAKEDAO_CURVE_HARVESTS=false
# Inverse FiRM pays permissionless DOLA rewards for forced DBR replenishment.
# The call is fixed-amount, private-only, capital-free, and defaults off while
# the very thin-margin competition policy is still being evaluated.
ENABLE_FIRM_REPLENISHMENTS=false
# Haircut applied when estimating the pool's gas-indexed bounty. This covers
# the difference between total simulated gas and PullPool's internal meter.
POOL_BOUNTY_ESTIMATE_BPS=9000
# Conservative limits for calls that only become estimable after an earlier
# transaction in the same private bundle changes state. Relay simulation still
# has to accept the complete sequence before it can be submitted.
POOL_PULL_GAS_LIMIT=3000000
POOL_SYNC_GAS_LIMIT=700000
POOL_SETTLE_GAS_LIMIT=700000
# A processed acquisition can cross 1.2M gas when its result path is complex.
# Relay simulation and whole-prefix economics remain the final safety gates.
FWA_PROCESS_GAS_LIMIT=3000000
# Clear a small ready FWA sequence backlog when our pool request is not yet the
# head. Exact return data, bundle simulation, and economics still gate it.
FWA_PROCESS_MAX_COUNT=5
BUYBACK_GAS_LIMIT=700000
LIVE_BID_SWEEP_GAS_LIMIT=250000
LIQUITY_GAS_LIMIT=15000000
LIQUITY_MAX_TROVES_PER_BATCH=25
CONVEX_EARMARK_GAS_LIMIT=1500000
CONVEX_KICK_GAS_LIMIT=500000
STAKEDAO_HARVEST_GAS_LIMIT=5000000
STAKEDAO_HARVEST_MAX_BATCH_SIZE=12
STAKEDAO_HARVEST_MAX_CANDIDATES=24
STAKEDAO_HARVEST_REWARD_HAIRCUT_BPS=9500
STAKEDAO_ORACLE_MAX_AGE_SECONDS=86400
STAKEDAO_DISCOVERY_BLOCK_RANGE=100000
FIRM_REPLENISH_GAS_LIMIT=400000
FIRM_MAX_CANDIDATES=64
FIRM_REWARD_HAIRCUT_BPS=9500
# DOLA/USD has a long heartbeat; ETH/USD is held to a much tighter freshness
# limit because stale ETH can materially overvalue a thin DOLA reward.
FIRM_DOLA_ORACLE_MAX_AGE_SECONDS=90000
FIRM_ETH_ORACLE_MAX_AGE_SECONDS=7200
FIRM_DISCOVERY_BLOCK_RANGE=100000
FIRM_BORROWER_LOOKBACK_BLOCKS=100000

# Dry-run mode estimates opportunities but never signs or broadcasts.
DRY_RUN=true
RUN_ONCE=false

# Required only when DRY_RUN=false. Fund this keeper EOA with gas ETH only.
PRIVATE_KEY=
SIMULATION_ACCOUNT=0x000000000000000000000000000000000000dEaD

# Private one-block Flashbots bundles are the default. Use "public" only as a
# fallback; losing public transactions can revert and still burn gas.
SUBMISSION_MODE=flashbots
# The first relay must support eth_callBundle because it is used for
# simulation. Later relays only receive bundles that passed that simulation.
# Flashbots multiplexing is supplemented with direct Titan and Beaver delivery
# for latency-sensitive ready-cycle bundles.
FLASHBOTS_RELAY_URLS=https://relay.flashbots.net,https://rpc.quasar.win,https://rpc.titanbuilder.xyz,https://rpc.beaverbuild.org
# The Flashbots relay multiplexes the bundle to these registered builders.
FLASHBOTS_BUILDERS=flashbots,builder0x69,beaverbuild.org,Titan,rsync
# Optional reputation identity. If blank, PRIVATE_KEY signs relay auth messages.
FLASHBOTS_AUTH_PRIVATE_KEY=
RELAY_TIMEOUT_MS=5000
# Percentage of each successful crank fee offered to the block builder.
# This is the adaptive controller's starting point and lower bound.
BUILDER_BID_BPS=8100
# A ready acquisition processor chain pays more than an ordinary fulfilled
# sync/settle. Pulls have a separate specialist market.
POOL_BUILDER_BID_BPS=1000
POOL_PULL_BUILDER_BID_BPS=2000
POOL_FULFILLED_BUILDER_BID_BPS=300
# Historical sweep winners paid zero priority fee. Offer builders 1% of the
# exact reward instead of inheriting the standing-order 81% bid.
LIVE_BID_SWEEP_BUILDER_BID_BPS=100
# Liquidations are competitive; start at the standing-order bid while keeping
# the policy independent so it can be tuned from observed outcomes.
LIQUITY_BUILDER_BID_BPS=8100
# Convex maintenance usually clears with small bids and has thin margins.
CONVEX_BUILDER_BID_BPS=1000
# Stake DAO harvest competitors have cleared with very small on-chain tips.
# Keep this independent from the standing-order bid.
STAKEDAO_BUILDER_BID_BPS=1000
# Recent FiRM competitors usually retain only tiny margins. Keep its builder
# share independent and let exact private-bundle economics cap the final tip.
FIRM_BUILDER_BID_BPS=1000
ADAPTIVE_BIDDING=true
# After a measurable loss, target the winner plus this many basis points.
ADAPTIVE_BID_STEP_BPS=25
ADAPTIVE_BID_MAX_BPS=9900
# Hold after wins, then reduce by 10 bps after three consecutive full wins.
ADAPTIVE_BID_WIN_STREAK=3
ADAPTIVE_BID_DECAY_BPS=10
ADAPTIVE_BID_STATE_PATH=.keeper-bid-state.json
# Used to measure direct block-beneficiary payments in competing transactions.
COMPETITOR_TRACE_URL=https://api.routescan.io/v2/network/mainnet/evm/1/internal-operations
COMPETITOR_TRACE_TIMEOUT_MS=5000
COMPETITOR_TRACE_RETRIES=5
COMPETITOR_TRACE_RETRY_DELAY_MS=1000

# Optional Discord webhook for important lifecycle, failure, and P&L embeds.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=5000
# Separate webhook used by `npm run codex:update -- "message"`.
CODEX_UPDATES_WEBHOOK=

# Optional durable structured telemetry. Run migrations before starting a
# deployment that sets DATABASE_URL.
DATABASE_URL=
TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_MS=250
TELEMETRY_MAX_QUEUE=10000

# Set above zero only when you want an absolute profit floor.
MIN_PROFIT_ETH=0
GAS_LIMIT_MULTIPLIER_BPS=12000
MAX_FEE_PER_GAS_GWEI=5
# A lower bound only; Flashbots mode derives its competitive tip from the
# simulated gas used and BUILDER_BID_BPS.
MIN_PRIORITY_FEE_GWEI=0.1
# Pool-only bundles have no forced priority floor; their configured percentage
# still creates a builder payment.
POOL_MIN_PRIORITY_FEE_GWEI=0
LIVE_BID_SWEEP_MIN_PRIORITY_FEE_GWEI=0

# Candidate gas estimates run concurrently, then preserve fee-ranked order.
SIMULATION_CONCURRENCY=8

# The loop reacts once per new block. Zero means no per-pass transaction limit.
BLOCK_POLL_MS=250
CONFIRMATIONS=1
RECEIPT_TIMEOUT_MS=180000
MAX_TRANSACTIONS_PER_PASS=0
